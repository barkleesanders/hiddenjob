{
  "data_dir": ".hiddenjob",
  "sources": [
    {
      "name": "jobsnow",
      "base_url": "https://www.jobs.now",
      "robots_url": "https://www.jobs.now/robots.txt",
      "sitemap_fallback": "https://www.jobs.now/sitemap.xml",
      "job_url_pattern": "/jobs/",
      "job_url_regex": "^/jobs/\\d+(?:[-/]|$)"
    },
    {
      "name": "hackernews",
      "kind": "hackernews",
      "limit": 50
    },
    {
      "name": "remoteok",
      "kind": "remoteok",
      "limit": 100
    },
    {
      "name": "remotive",
      "kind": "remotive",
      "limit": 100
    },
    {
      "name": "arbeitnow",
      "kind": "arbeitnow",
      "limit": 100
    },
    {
      "name": "usajobs",
      "kind": "usajobs",
      "api_key_env": "USAJOBS_API_KEY",
      "keyword": "",
      "limit": 50
    }
  ],
  "company_hosts": [
    {
      "company": "Example Company",
      "host": "careers.example.com",
      "enabled": false
    }
  ],
  "ats_targets_file": "hiddenjobs-targets.json"
}
